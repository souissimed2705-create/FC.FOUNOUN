rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // The client may read only its own profile. All profile mutations are
    // performed by the authenticated Cloudflare Worker backend.
    match /users/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Catalog reads are intentionally public; every write is mediated by Worker.
    match /models/{modelId} {
      allow read: if true;
      allow write: if false;
    }

    // Internal uniqueness reservations are backend-only.
    match /model_names/{nameHash} {
      allow read, write: if false;
    }

    // Worker identities, machine assignments and secret-code hashes are backend-only.
    match /workers/{workerId} {
      allow read, write: if false;
    }
    match /worker_pins/{workerId} {
      allow read, write: if false;
    }
    match /worker_auth_attempts/{workerId} {
      allow read, write: if false;
    }

    // Named-code management identities and their hashes are backend-only.
    match /management_codes/{uid} {
      allow read, write: if false;
    }
    match /management_auth_attempts/{uid} {
      allow read, write: if false;
    }

    // Responsible day/night reservations are internal coordination records.
    match /management_responsible_slots/{shift} {
      allow read, write: if false;
    }

    // Tasks, progress ledger, conversations and cycle reports must only be
    // accessed through Worker endpoints enforcing role/ownership checks.
    match /tasks/{taskId} {
      allow read, write: if false;
    }
    match /task_progress/{mutationId} {
      allow read, write: if false;
    }
    match /messages/{messageId} {
      allow read, write: if false;
    }
    match /conversations/{conversationId} {
      allow read, write: if false;
    }
    match /machine_cycles/{reportId} {
      allow read, write: if false;
    }

    // Deny every unlisted collection by default.
  }
}